# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (new naming) — safe for the browser, RLS enforces access.
# Legacy Supabase projects call this the "anon" key; either works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (new naming) — server-side ONLY, bypasses RLS. Never expose to the client.
# Legacy Supabase projects call this the "service_role" key; either works here.
SUPABASE_SECRET_KEY=

# ai.google.dev → Get API Key
GEMINI_API_KEY=

# Shared secret checked by /api/sync to confirm the call came from Vercel Cron
# or the app's own navbar button. Generate any random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Note: the Riot API key is NOT an env var — it's stored in the `sync_state`
# table in Supabase instead, so it can be refreshed without a redeploy.
# See docs/02_ARCHITECTURE.md §4.
